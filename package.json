{
  "name": "apartment-advisor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:server": "node server.js",
    "build": "prisma generate && prisma migrate deploy && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "make-admin": "node scripts/make-admin.js",
    "seed": "node scripts/seed.js"
    ,"chat:dev": "cd rauls-chatbot && pnpm install && pnpm dev"
    ,"chat:build": "cd rauls-chatbot && pnpm install && pnpm build"
  },
  "dependencies": {
    "@aws-sdk/rds-signer": "^3.975.0",
    "@neondatabase/serverless": "^1.0.2",
    "@next-auth/prisma-adapter": "^1.0.5",
    "@prisma/client": "5.15.0",
    "@vercel/functions": "^3.3.6",
    "autoprefixer": "10.4.0",
    "bcryptjs": "^2.4.3",
    "express": "^5.2.1",
    "firebase": "^12.8.0",
    "firebase-admin": "^13.6.0",
    "next": "^16.1.4",
    "next-auth": "^4.22.1",
    "nodemailer": "^7.0.12",
    "pg": "^8.17.2",
    "postcss": "^8.5.6",
    "prisma": "5.15.0",
    "qrcode": "^1.5.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "speakeasy": "^2.0.0",
    "tailwindcss": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/node": "25.0.9",
    "@types/react": "19.2.8",
    "playwright": "^1.57.0",
    "typescript": "5.1.6"
  }
}
