{
  "name": "apartment-advisor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:server": "node server.js",
    "build": "prisma generate && node scripts/run_migrations_if_postgres.mjs && next build",
    "vercel-build": "prisma generate && node scripts/run_migrations_if_postgres.mjs && next build && mkdir -p .output/public && cp -r .next/* .output/public/",
    "postinstall": "prisma generate",
    "start": "next start",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "make-admin": "node scripts/make-admin.js",
    "seed": "node scripts/seed.js",
    "chat:dev": "pnpm --prefix ./rauls-chatbot install && pnpm --prefix ./rauls-chatbot dev",
    "chat:build": "pnpm --prefix ./rauls-chatbot install && pnpm --prefix ./rauls-chatbot build"
  },
  "dependencies": {
    "@aws-sdk/rds-signer": "^3.975.0",
    "@neondatabase/serverless": "^1.0.2",
    "@next-auth/prisma-adapter": "^1.0.5",
    "@prisma/client": "5.15.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-visually-hidden": "^1.1.0",
    "@sendgrid/mail": "^8.1.6",
    "@vercel/analytics": "^1.3.1",
    "@vercel/blob": "^0.24.1",
    "@vercel/functions": "^3.3.6",
    "@vercel/otel": "^1.12.0",
    "autoprefixer": "10.4.0",
    "bcrypt-ts": "^5.0.2",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.1",
    "express": "^5.2.1",
    "firebase": "^12.8.0",
    "firebase-admin": "^13.6.0",
    "framer-motion": "^11.3.19",
    "lucide-react": "^0.446.0",
    "nanoid": "^5.1.3",
    "next": "^16.1.4",
    "next-auth": "^4.22.1",
    "next-themes": "^0.3.0",
    "nodemailer": "^7.0.12",
    "pg": "^8.17.2",
    "postcss": "^8.5.6",
    "postgres": "^3.4.4",
    "prisma": "5.15.0",
    "qrcode": "^1.5.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-resizable-panels": "^2.1.7",
    "sonner": "^1.5.0",
    "speakeasy": "^2.0.0",
    "swr": "^2.2.5",
    "tailwindcss": "3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/bcryptjs": "^2.4.2",
    "@types/node": "25.0.9",
    "@types/react": "19.2.8",
    "playwright": "^1.57.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.1.6"
  }
}
