# Database (set in Vercel / environment)
DATABASE_URL=

# SendGrid (preferred)
# Create an API key in SendGrid and paste it here
SENDGRID_API_KEY=
# Optional 'from' address used when sending via SendGrid
SENDGRID_FROM=no-reply@example.com

# Fallback SMTP settings (if not using SendGrid)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Email target for contact form notifications
CONTACT_TO=you@example.com

# Helpful for Next/NextAuth providers
GOOGLE_ID=
GOOGLE_SECRET=

# Set to 'production' on deploy platforms
NODE_ENV=development
# Copy to .env.local and fill values
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me
DATABASE_URL="file:./dev.db"
GITHUB_ID=your_github_app_client_id
GITHUB_SECRET=your_github_app_client_secret
GOOGLE_ID=your_google_client_id
GOOGLE_SECRET=your_google_client_secret
# Development-only quick sign-in. Set DEV_AUTH=true to enable a credentials provider
# Use these values to sign in locally via the "Development" provider (only for dev/testing).
DEV_AUTH=false
DEV_AUTH_EMAIL=dev@local
DEV_AUTH_PASSWORD=devpassword
# Allow anonymous socket connections in development or when enabled
# Set NEXT_PUBLIC_ALLOW_ANON_SOCKETS=true to allow sockets without sign-in
NEXT_PUBLIC_ALLOW_ANON_SOCKETS=true
